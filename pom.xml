<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.motorfraude</groupId>
        <artifactId>motor-fraude-parent</artifactId>
        <version>0.1.0</version>
        <relativePath/>
    </parent>

    <artifactId>load-generator</artifactId>
    <name>load-generator</name>
    <description>Gerador de carga sintética com cenários de fraude, em modelo aberto (spec 000, H4).</description>

    <properties>
        <!-- Classe principal: usada pelo exec:java e pelo jar executável -->
        <load-generator.main>br.com.motorfraude.loadgenerator.Main</load-generator.main>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.motorfraude</groupId>
            <artifactId>contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>br.com.motorfraude</groupId>
            <artifactId>contracts</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Execução: ./mvnw -pl load-generator exec:java com -Dexec.args (ver README, seção "Teste de carga") -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${load-generator.main}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <!-- Jar executável (java -jar load-generator/target/load-generator.jar ...): mede sem o Maven por perto -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>load-generator</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${load-generator.main}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Artefatos compartilhados: GitHub Packages (repositórios privados). Leitura e escrita exigem um token
         configurado no ~/.m2/settings.xml com o id github-motor-fraude (ver README). Sem registry, use ./mvnw install
         nos repositórios motor-fraude-parent, contracts e platform-commons, nessa ordem. -->
    <repositories>
        <repository>
            <id>github-motor-fraude</id>
            <url>https://maven.pkg.github.com/luizavramos/*</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>github-motor-fraude</id>
            <url>https://maven.pkg.github.com/luizavramos/load-generator</url>
        </repository>
    </distributionManagement>
</project>
